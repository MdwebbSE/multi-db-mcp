{
  "transport_security": {
    "enable_dns_rebinding_protection": true,
    "allowed_hosts": [
      "localhost:*",
      "127.0.0.1:*"
    ],
    "allowed_origins": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "servers": {
    "your-server-name": {
      "engine": "mysql",
      "host": "your-host",
      "port": 3306,
      "user": "your-user",
      "password": "your-password",
      "allowed_databases": ["your-db"],
      "connect_timeout": 10
    }
  }
}
